{
  "expo": {
    "name": "Gluten-Free",
    "slug": "global-gluten-free",
    "version": "0.1.0",
    "orientation": "portrait",
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Gluten-Free to use your location while you use the app to find nearby restaurants."
        }
      ]
    ],
    "android": {
      "package": "com.globalglutenfree.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "edf6ec79-832b-462a-b228-e1df863b274e"
      }
    },
    "owner": "dariocst"
  }
}
